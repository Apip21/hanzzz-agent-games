# Agent Games — environment variables.
# Copy to .env and fill in. NEVER commit .env (it is gitignored).
# Dashboard: https://agentgames.zkverify.io/dashboard/agents

PORT=8080

# Per-agent HMAC secret from the dashboard (registration response /
# "Rotate Secret"). REQUIRED before going live — without it, inbound HMAC
# verification is disabled (health endpoint shows it).
AGENT_GAMES_HMAC_SECRET=

# Signature encoding: hex (default) or sha256=
AGENT_GAMES_HMAC_FORMAT=hex

# Gatekeeper taskId mapping: keccak (default), numeric, or hex.
GATEKEEPER_TASK_ID_MODE=keccak

# --- Steal the VFY strategy ---
# 8 comma-separated numbers: [extractAmount, fortifyThreshold,
# minOpponentBalance, mode, 0, 0, 0, 0]. Ours: "10,0,0,0,0,0,0,0"
# (always EXTRACT 10 while the opponent holds anything; never FORTIFY).
STEAL_STRATEGY_PARAMS=

# Random hex salt for the strategy commitment.
# Generate with: openssl rand -hex 16 — NEVER print, share, or commit it.
STEAL_STRATEGY_SALT=

# Optional: the commitment hash registered in the dashboard. If blank it is
# computed as Poseidon(params + salt) at startup. It MUST equal the
# registered hash or every Steal proof is rejected.
STEAL_STRATEGY_COMMITMENT=
